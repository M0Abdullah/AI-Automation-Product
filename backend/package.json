{
  "name": "aitest-backend",
  "version": "0.1.0",
  "description": "AI testing platform - control plane (NestJS) + browser worker (Playwright)",
  "private": true,
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:studio": "prisma studio",
    "playwright:install": "playwright install chromium",
    "setup": "npm install && npm run prisma:generate && npm run prisma:migrate && npm run playwright:install",
    "check:llm": "ts-node -r tsconfig-paths/register scripts/check-llm.ts",
    "check:browser": "ts-node -r tsconfig-paths/register scripts/check-browser.ts",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "set:owner": "ts-node -r tsconfig-paths/register scripts/set-owner.ts",
    "kill": "powershell -NoProfile -ExecutionPolicy Bypass -File ../kill-ports.ps1"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "openai": "^4.104.0",
    "playwright": "^1.50.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "prisma": "^6.2.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  }
}
