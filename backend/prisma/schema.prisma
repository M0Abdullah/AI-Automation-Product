// ===========================================================================
// DATA MODEL — MongoDB
//
// Lifecycle enforced by these collections:
//   Project -> Run -> RunPage -> TestCase -> TestResult -> Finding -> FindingEvent
//
// WHY MONGODB: the two things SQLite forced us to fake are native here.
//   * Json / jsonb   -> `Json` columns. No packJson()/unpackJson().
//   * String[]       -> real arrays. No comma-separated packing.
// So src/common/db-json.ts and src/common/hydrate.ts are GONE — the API
// payloads are produced directly by the driver instead of being reassembled.
//
// IDS: `String @id @map("_id") @default(uuid())` rather than ObjectId.
// Deliberate: it keeps every id a plain UUID string, so no field in the
// codebase needs @db.ObjectId and no url, log line or bug report changes shape.
//
// THE OPTIONAL-UNIQUE TRAP (read this before adding `@unique` to anything).
//
// Prisma creates MongoDB unique indexes NON-SPARSE, and MongoDB indexes a
// MISSING field as null. So two documents that both omit an optional unique
// field collide on it:
//
//   finding A: { ... }                 -> contentIssueId indexed as null
//   finding B: { ... }                 -> DUPLICATE KEY, write rejected
//
// That is not a corner case: it made the second Finding ever created fail, which
// meant the platform could hold exactly one finding for its whole lifetime.
//
// RULE: `@unique` only on a REQUIRED field. For an optional one, use a plain
// @@index and enforce uniqueness in application code. Prisma forces the FK side
// of a 1:1 to be @unique, so the three optional relations on Finding are
// declared one-to-many in the schema and kept one-to-one by the services -
// which is where that rule actually lives anyway (see createFinding and the
// promote endpoints).
//
// ENUMS: still `String` columns with the allowed values in src/common/enums.ts.
// Mongo supports Prisma enums, but a status is written from ~40 places and a
// String column keeps `statusMessage`-style free text and the enum on the same
// footing. The const objects in enums.ts are the single source of truth.
//
// SCHEMA CHANGES: Mongo has no migrations. Use `npx prisma db push`.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------- entities ----

model Project {
  id        String   @id @map("_id") @default(uuid())
  name      String
  baseUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@map("projects")
}

model Run {
  id        String  @id @map("_id") @default(uuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  name String

  /// THE ENTRY URL. Where the crawl starts, and the page a single-page run tests.
  ///
  /// Still called targetUrl because for a single-page run it is exactly that.
  /// For a whole-app run it is the front door: every other page in the run is
  /// discovered from here and recorded as a RunPage.
  targetUrl    String
  requirements String
  /// Check ids from src/common/check-catalog.ts — the boxes the user ticked.
  /// Stored so a re-plan repeats the same intent.
  checks       String[] @default([])

  // ------------------------------------------------------------- crawl scope
  /// WHOLE-APP MODE. False = test targetUrl only (the original behaviour).
  ///
  /// True = discover the app's pages by following same-origin links from
  /// targetUrl, then scan, plan and execute against every one of them. One run
  /// covers the product instead of one screen.
  crawlEnabled Boolean @default(false)
  /// Hard ceiling on pages per run. The real constraint is LLM calls: planning
  /// costs one call per page, so 20 pages is 20 calls plus 20 scans.
  maxPages     Int     @default(10)
  /// Link depth from the entry URL. 1 = only pages linked directly from it.
  maxDepth     Int     @default(2)
  /// Path substrings that a discovered URL must contain to be crawled.
  /// Empty = no restriction.
  includePaths String[] @default([])
  /// Path substrings that exclude a discovered URL. Applied after includePaths,
  /// on top of the always-excluded set in site-crawler.service.ts.
  excludePaths String[] @default([])

  /// Where to sign in, when the app sits behind a login.
  /// Null means "do not sign in" - the run tests the app as an anonymous visitor.
  loginUrl        String?
  /// Optional overrides for when auto-detection cannot find the fields.
  loginEmailField String?
  loginPassField  String?
  loginSubmit     String?
  /// Set once a session has been established, for the UI to show "signed in as".
  sessionEvidence String?

  // ------------------------------------------------------ design comparison
  /// Both must be set for the check to run.
  /// From a URL like figma.com/design/<key>/Name?node-id=<node>
  figmaFileKey String?
  figmaNodeId  String?
  /// WHICH PAGE THE DESIGN IS COMPARED AGAINST.
  ///
  /// The design check is single-page ON PURPOSE, even when the run crawls the
  /// whole app: a Figma frame is one screen's design. Comparing a settings page
  /// against a login frame produces noise, not findings. Null = the entry URL.
  designPageUrl String?
  /// One-line summary of what was read, e.g. "Buttons - 2196 layers, heights 32,36,40".
  designSpecSummary String?

  /// RunStatus — see src/common/enums.ts
  status        String  @default("CREATED")
  statusMessage String?

  // Consent flags captured from the user before anything is opened.
  authorized       Boolean @default(false)
  allowDestructive Boolean @default(false)

  /// The PageSnapshot for the ENTRY page, kept so a single-page run reads
  /// exactly as it always did. Whole-app runs additionally store one snapshot
  /// per RunPage.
  pageSnapshot Json?

  // Observability for the LLM calls. Totalled across every page planned.
  llmModel     String?
  llmTokensIn  Int?
  llmTokensOut Int?
  llmLatencyMs Int?

  createdAt      DateTime  @default(now())
  crawlStartedAt DateTime?
  scanStartedAt  DateTime?
  planStartedAt  DateTime?
  execStartedAt  DateTime?
  finishedAt     DateTime?

  createdBy   User?   @relation("runCreator", fields: [createdById], references: [id])
  createdById String?

  secret        RunSecret?
  pages         RunPage[]
  testCases     TestCase[]
  results       TestResult[]
  findings      Finding[]
  contentIssues ContentIssue[]
  designIssues  DesignIssue[]
  rejections    PolicyRejection[]

  @@index([projectId, createdAt])
  @@map("runs")
}

/// ONE PAGE OF THE APP UNDER TEST.
///
/// This is what makes a run cover a product rather than a screen. The crawler
/// creates one row per discovered page; the scan, the plan and the wording pass
/// then run per row, and every TestCase points back at the page it was written
/// for so the executor knows where to start.
///
/// A single-page run has exactly one of these (isEntry = true), which is why
/// nothing downstream needs a special case for it.
model RunPage {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// The URL as discovered, normalised (no hash, no trailing slash).
  url String
  /// Just the path+query, for a compact UI label.
  path String
  /// The <title> once scanned. Null until then.
  title String?
  /// The entry URL the user submitted. Exactly one page per run has this set.
  isEntry Boolean @default(false)
  /// Which page linked to this one, and how far from the entry it sits.
  /// Kept because "why is this page in my run" is a question QA will ask.
  discoveredFrom String?
  depth          Int     @default(0)
  /// Crawl order, which is also the order the UI lists pages in.
  order          Int     @default(0)

  /// RunPageStatus — DISCOVERED | SCANNING | SCANNED | PLANNED | SCAN_FAILED |
  /// PLAN_FAILED | SKIPPED  (see src/common/enums.ts)
  status        String  @default("DISCOVERED")
  statusMessage String?

  /// The PageSnapshot handed to the LLM for THIS page.
  pageSnapshot Json?
  /// Element count, denormalised so the page list renders without loading
  /// every snapshot.
  elementCount Int @default(0)

  scannedAt DateTime?
  plannedAt DateTime?
  createdAt DateTime  @default(now())

  testCases     TestCase[]
  contentIssues ContentIssue[]
  designIssues  DesignIssue[]

  @@index([runId, order])
  @@map("run_pages")
}

/// Encrypted test credentials. The plaintext never reaches the LLM — the model
/// only ever sees a reference name such as "test_email".
model RunSecret {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String @unique

  /// AES-256-GCM payloads, format: iv:authTag:cipherText (all hex)
  emailCipher    String?
  passwordCipher String?

  /// The signed-in browser state (cookies + localStorage), encrypted.
  ///
  /// Encrypted because a live session cookie is as sensitive as the password
  /// that produced it. Stored rather than held in memory because the scan
  /// happens before approval and execution happens after - possibly hours
  /// later - and both need the same session. Wiped when the run finishes.
  sessionCipher    String?
  sessionCreatedAt DateTime?

  createdAt DateTime @default(now())

  @@map("run_secrets")
}

model TestCase {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// WHICH PAGE THIS CASE TESTS.
  ///
  /// Optional only so cases written before whole-app mode still load. New cases
  /// always have it, and pageUrl below is what the executor actually starts at.
  page   RunPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String?
  /// Denormalised start URL. Kept on the case rather than read through the
  /// relation because the executor needs it for every attempt, and because a
  /// manually edited case may point somewhere the crawler never visited.
  pageUrl String?

  title       String
  priority    String   @default("P2") // P0..P3
  /// CaseSource — LLM | MANUAL
  source      String   @default("LLM")
  order       Int      @default(0)
  tags        String[] @default([])
  rationale   String? // why the AI proposed this case
  requirement String? // which requirement line it traces to

  /// [{ action, target, valueRef?, value?, description }]
  steps      Json
  /// [{ type, target?, value?, description }]
  assertions Json

  approved        Boolean   @default(false)
  approvedAt      DateTime?
  rejected        Boolean   @default(false)
  rejectionReason String?
  destructive     Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  results  TestResult[]
  findings Finding[]

  @@index([runId, order])
  @@index([pageId, order])
  @@map("test_cases")
}

model TestResult {
  id         String   @id @map("_id") @default(uuid())
  run        Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseId String

  attempt Int    @default(1) // 2 = automatic rerun
  /// ResultStatus — PASS | FAIL | FLAKY | ERROR | SKIPPED
  status  String

  startedAt  DateTime
  finishedAt DateTime
  durationMs Int

  // Failure detail — filled only when status is FAIL or ERROR.
  failedStepIndex Int?
  failedStepLabel String?
  expected        String?
  actual          String?
  /// ErrorType — LOCATOR_NOT_FOUND | ASSERTION_FAILED | TIMEOUT | NAVIGATION |
  /// PAGE_CRASH | POLICY_BLOCKED | UNKNOWN
  errorType       String?
  errorMessage    String?

  // Environment recorded for every result (a QA report needs this).
  browserName    String  @default("chromium")
  browserVersion String?
  viewport       String?
  finalUrl       String?

  /// [{ index, action, target, status, locatorStrategy, durationMs, message }]
  stepResults Json

  screenshotPath String?
  tracePath      String?

  consoleLogs ConsoleLog[]
  networkLogs NetworkLog[]
  /// AT MOST ONE, despite the list type. See the optional-unique note at the
  /// top of this file: a unique FK on Finding.resultId would reject every
  /// finding that has no result. createFinding is the only writer and it checks
  /// for an existing one first.
  findings    Finding[]

  @@index([runId])
  @@index([testCaseId, attempt])
  @@map("test_results")
}

/// Every browser console message captured during the run.
model ConsoleLog {
  id       String     @id @map("_id") @default(uuid())
  result   TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId String

  /// LogLevel — ERROR | WARNING | INFO | DEBUG
  level    String
  message  String
  location String?
  at       DateTime @default(now())

  @@index([resultId, level])
  @@map("console_logs")
}

/// Every request the page made. isApiError marks 4xx/5xx on xhr/fetch calls —
/// that is the "API error" list QA wants to see.
model NetworkLog {
  id       String     @id @map("_id") @default(uuid())
  result   TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId String

  method       String
  url          String
  status       Int?
  statusText   String?
  resourceType String?
  failureText  String? // set when the request never completed
  durationMs   Int?
  isApiError   Boolean  @default(false)
  at           DateTime @default(now())

  @@index([resultId, isApiError])
  @@map("network_logs")
}

/// A failure awaiting human judgement. NOT a bug until a human confirms it.
model Finding {
  id String @id @map("_id") @default(uuid())

  /// WHERE THIS FINDING CAME FROM.
  ///
  /// Findings used to be possible only from a failed test, which forced
  /// resultId and testCaseId to exist. But a typo is not a test result, and
  /// neither is a layout that disagrees with the Figma design - both are real
  /// defects a human confirmed. Rather than fabricating a synthetic test case
  /// to hang them on (which would corrupt every pass/fail count), the two test
  /// relations are optional and this field says which kind of finding it is.
  ///
  /// FindingSource - TEST | CONTENT | DESIGN
  source String @default("TEST")

  /// Set for source=TEST only.
  ///
  /// NOT @unique - it is optional, and a unique index over the CONTENT and
  /// DESIGN findings that legitimately have no result would reject all but the
  /// first of them. "One finding per result" is enforced in createFinding.
  result   TestResult? @relation(fields: [resultId], references: [id], onDelete: Cascade)
  resultId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCaseId String?

  /// Always set: every finding belongs to a run.
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// Set for source=CONTENT: the wording suggestion a human promoted.
  /// Not @unique - see the note at the top. The promote endpoint refuses to
  /// mint a second bug for an issue that already has one.
  contentIssue   ContentIssue? @relation(fields: [contentIssueId], references: [id], onDelete: SetNull)
  contentIssueId String?

  /// Set for source=DESIGN: the design deviation a human promoted.
  designIssue   DesignIssue? @relation(fields: [designIssueId], references: [id], onDelete: SetNull)
  designIssueId String?

  /// A one-line title, needed because a CONTENT or DESIGN finding has no
  /// test case to borrow one from.
  title String?

  /// FindingStatus — NEW | TRIAGED | CONFIRMED | REJECTED | REOPENED | CLOSED
  status   String  @default("NEW")
  /// Severity — S1_BLOCKER | S2_MAJOR | S3_MINOR | S4_TRIVIAL
  severity String?
  assignee String?

  /// Stable hash of (testCaseId + errorType + failed step + normalised message).
  /// Same signature = same problem, so repeats update instead of duplicating.
  signature String

  // --- AI advisory fields. Suggestions only, never a verdict. ---
  /// Classification - WHOSE fault. See src/common/enums.ts
  aiClassification String?
  /// BugCategory - WHAT KIND of defect. Independent axis from aiClassification:
  /// a defect can be PRODUCT_BUG + UI_VISUAL, or PRODUCT_BUG + DATA.
  aiCategory       String?
  aiConfidence     Float?
  aiSummary        String?
  aiSuspectedCause String?
  /// { consoleErrors, apiErrors, attempts, evidenceUsed, ... }
  aiEvidence       Json?

  // --- Human decision ---
  humanClassification String?
  triagedBy           String?
  triagedAt           DateTime?
  note                String?

  // --- bug report identity (assigned when QA confirms it as a defect) ---
  /// Human-readable id, e.g. BUG-001. Null until confirmed.
  ///
  /// Not @unique for the same reason: most findings never get one, and a
  /// non-sparse unique index would let only ONE un-confirmed finding exist.
  /// Uniqueness comes from the Counter collection instead, which allocates
  /// these with an atomic findAndModify - a stronger guarantee than an index,
  /// because it cannot hand out the same number twice in the first place.
  bugKey    String?
  bugNumber Int?
  /// Which part of the product this defect lives in.
  module    String?
  /// Build / version / commit under test.
  build     String?
  /// How soon it must be fixed. Separate axis from severity (how bad it is).
  priority  String?

  occurrences Int      @default(1)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events FindingEvent[]
  ticket Ticket?

  @@index([runId, status])
  @@index([signature])
  // Plain indexes where the unique ones used to be: the lookups they served
  // ("is there already a finding for this result / issue?") still happen on
  // every promote and every failure, they just are not uniqueness constraints.
  @@index([resultId])
  @@index([contentIssueId])
  @@index([designIssueId])
  @@index([bugKey])
  @@map("findings")
}

/// Append-only audit trail: who moved the finding, when, and why.
model FindingEvent {
  id        String  @id @map("_id") @default(uuid())
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String

  fromStatus String?
  toStatus   String
  actor      String   @default("qa@local")
  note       String?
  createdAt  DateTime @default(now())

  @@index([findingId, createdAt])
  @@map("finding_events")
}

/// Anything the policy engine refused to execute, kept for transparency.
model PolicyRejection {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  stage   String // LLM_SCHEMA | ACTION_NOT_ALLOWED | DESTRUCTIVE | ...
  subject String
  reason  String
  /// Which page's plan this rejection came from, so a 12-page run can say
  /// WHERE the rejected step was proposed. Null for run-level rejections.
  pageUrl String?
  /// The offending step or assertion.
  payload Json?

  createdAt DateTime @default(now())

  @@index([runId])
  @@map("policy_rejections")
}

// ===========================================================================
// AUTHENTICATION
//
// Real accounts, because "who confirmed this bug" and "who is this assigned to"
// are core QA questions - they cannot be answered by a hardcoded "qa@local".
// Passwords use scrypt (Node built-in): no native dependency, no npm risk.
// ===========================================================================

model User {
  id           String    @id @map("_id") @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  /// Role - OWNER | QA | DEV | VIEWER (see src/common/enums.ts)
  role         String    @default("QA")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  sessions        LoginSession[]
  createdRuns     Run[]           @relation("runCreator")
  assignedTickets Ticket[]        @relation("ticketAssignee")
  reportedTickets Ticket[]        @relation("ticketReporter")
  ticketComments  TicketComment[]

  @@map("users")
}

/// One row per login. Doubles as the refresh-token store and the login history
/// ("save user record of login") - who signed in, from where, and when.
model LoginSession {
  id     String @id @map("_id") @default(uuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// SHA-256 of the refresh token. The raw token is never stored.
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, createdAt])
  @@map("login_sessions")
}

// ===========================================================================
// TICKETS
//
// A ticket is created FROM a confirmed finding, prefilled with the evidence the
// run already captured. The finding stays the QA record; the ticket is the
// developer-facing work item with an assignee and a lifecycle.
// ===========================================================================

model Ticket {
  id     String @id @map("_id") @default(uuid())
  /// Human-readable key, e.g. TICKET-001. What people say out loud.
  key    String @unique
  number Int    @unique

  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  findingId String  @unique

  title       String
  description String

  /// TicketStatus - OPEN | IN_PROGRESS | READY_FOR_RETEST | RESOLVED | REOPENED | CLOSED
  status   String    @default("OPEN")
  /// Priority is a separate axis from severity: how soon vs how bad.
  priority String    @default("P2")
  severity String?
  module   String?
  build    String?
  labels   String[]  @default([])
  dueDate  DateTime?

  assignee   User?   @relation("ticketAssignee", fields: [assigneeId], references: [id])
  assigneeId String?
  reporter   User?   @relation("ticketReporter", fields: [reporterId], references: [id])
  reporterId String?

  // --- external tracker (Jira / Linear / GitHub), filled by the connector ---
  externalKey       String?
  externalUrl       String?
  externalProvider  String?
  externalSyncedAt  DateTime?
  /// Idempotency key so a double-click cannot create two Jira issues.
  ///
  /// Not @unique, again because it is optional: every ticket that has not been
  /// pushed leaves it unset, and a non-sparse unique index would allow only one
  /// such ticket. pushToTracker claims it before calling out and re-reads the
  /// row on entry, which is what actually prevents the double-create.
  externalRequestId String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  closedAt   DateTime?

  comments TicketComment[]
  events   TicketEvent[]

  @@index([status, priority])
  @@index([externalRequestId])
  @@map("tickets")
}

model TicketComment {
  id       String @id @map("_id") @default(uuid())
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

/// Append-only audit trail for a ticket: every field change, with who and when.
model TicketEvent {
  id       String @id @map("_id") @default(uuid())
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  field     String // status | assignee | priority | severity | comment | created
  fromValue String?
  toValue   String?
  actor     String   @default("system")
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
  @@map("ticket_events")
}

/// Atomic sequence generator for human-readable keys (BUG-001, TICKET-001).
/// Counting rows races under concurrency; findAndModify on one document does not.
model Counter {
  name  String @id @map("_id")
  value Int    @default(0)

  @@map("counters")
}

/// ADVISORY ONLY - wording problems found by reading the page text.
///
/// Deliberately NOT a Finding: a spell-check on real copy will flag brand names
/// and jargon, and a noisy false bug destroys trust in every other result. These
/// are suggestions a human can promote, never a FAIL and never an automatic bug.
model ContentIssue {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// Which page the wording was read from. A 12-page run needs this to be
  /// actionable: "Contnue" is useless without knowing which screen it is on.
  page   RunPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String?
  pageUrl String?

  /// ContentIssueKind - TYPO | GRAMMAR | LABEL | CASING | PLACEHOLDER | INCONSISTENT
  kind       String
  /// The exact text as it appears on the page.
  text       String
  /// What it probably should say. Null when the model only flags a doubt.
  suggestion String?
  /// Why it looks wrong, in one line.
  reason     String?
  /// 0..1. Anything under the display threshold is stored but shown as low.
  confidence Float   @default(0)
  /// Where on the page it was seen (heading, button, label...).
  whereSeen  String?

  /// Human decision, so dismissals stick between runs.
  /// ContentIssueStatus - NEW | ACCEPTED | DISMISSED
  status     String   @default("NEW")
  reviewedBy String?
  reviewedAt DateTime?

  /// Set once a human promotes this suggestion into a real defect.
  /// At most one - the promote endpoint is idempotent. A list only because
  /// Prisma would otherwise require a unique FK; see the note at the top.
  findings Finding[]

  createdAt DateTime @default(now())

  @@index([runId, status])
  @@map("content_issues")
}

/// ADVISORY - a place the live page disagrees with the Figma design.
///
/// Same contract as ContentIssue and for the same reason: a design comparison
/// can never be certain that a difference is a mistake rather than a component
/// the design does not cover. So these are suggestions a human promotes, never
/// automatic bugs.
model DesignIssue {
  id    String @id @map("_id") @default(uuid())
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// The single page the design was compared against. Set even though the check
  /// is single-page, so the UI can say WHICH page the Figma frame was matched to.
  page   RunPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String?
  pageUrl String?

  /// WHAT WAS MEASURED.
  ///
  /// "button height" | "corner radius" | "font size" | "font family" |
  /// "font weight" | "text colour" | "background colour" | "border colour" |
  /// "element width" | "element height" | "spacing" | "icon size"
  /// The catalogue lives in src/design/design-compare.ts.
  property String
  /// Which family of properties this belongs to, so the UI can group and the
  /// user can dismiss a whole class ("stop telling me about colours").
  /// DesignIssueGroup - SIZE | TYPOGRAPHY | COLOUR | SPACING | ICON
  group    String  @default("SIZE")
  /// The element, in words a human can find on the page.
  element  String
  selector String
  actual   String
  expected String
  /// Distance from the design value. Smaller = more likely a genuine mistake.
  /// Pixels for geometry and type; weighted RGB distance for colour. Both land
  /// in the same small range, so one "closest misses first" ordering works
  /// across every property.
  offBy    Int
  note     String?

  /// ContentIssueStatus - NEW | ACCEPTED | DISMISSED
  status     String    @default("NEW")
  reviewedBy String?
  reviewedAt DateTime?

  /// Set once a human promotes this into a real defect.
  /// At most one, for the same reason as ContentIssue.findings.
  findings Finding[]

  createdAt DateTime @default(now())

  @@index([runId, status])
  @@map("design_issues")
}
