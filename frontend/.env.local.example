# ---------------------------------------------------------------------------
# FRONTEND ENV — copy to .env.local
#   cp .env.local.example .env.local
#
# WARNING: anything with the NEXT_PUBLIC_ prefix is shipped to the browser and
# is readable by every visitor. NEVER put the LLM API key in this file.
# The LLM key lives ONLY in backend/.env.
# ---------------------------------------------------------------------------

# Where the NestJS backend is reachable from the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# How often (ms) the run page polls the backend while a run is in progress.
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
