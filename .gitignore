# dependencies
node_modules/
# env — NEVER commit these, they hold the LLM key
.env
.env.local
*.env.local
# build output. Anchored for the same reason as /artifacts/ below.
/backend/dist/
/frontend/.next/
/frontend/out/
dist/
.next/
out/
# generated prisma client
backend/src/generated/
# incremental typescript build cache. Regenerated on every build, and it
# churns on every commit if tracked.
*.tsbuildinfo
# test evidence (screenshots / traces / videos)
#
# ANCHORED with a leading slash, and that matters: the unanchored form
# "artifacts/" matches a directory of that name at ANY depth, which silently
# excluded backend/src/artifacts/ - the source module that serves the evidence.
# The published repo would not compile from a fresh clone, and it only showed
# up once CI built from tracked files instead of a working copy.
/artifacts/
!/artifacts/.gitkeep
# logs
*.log
npm-debug.log*
# os
.DS_Store
Thumbs.db

# local scratch output from the diagnostic scripts
check-browser.png

# stray local database files. The platform runs on MongoDB now, but an old
# SQLite dev.db may still be sitting in a working copy from before the move.
*.db
*.db-journal
backend/prisma/*.db
