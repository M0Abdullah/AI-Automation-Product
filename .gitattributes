# Normalise to LF in the repository, whatever the checkout platform does.
# Without this the Windows and CI checkouts disagree about every line, and a
# one-line change shows up as a whole-file rewrite in review.
* text=auto eol=lf

# Windows-only tooling that must keep CRLF to run.
*.ps1 text eol=crlf

# Never touched, never diffed.
*.png binary
*.jpg binary
*.pdf binary
*.ico binary
package-lock.json -diff linguist-generated
